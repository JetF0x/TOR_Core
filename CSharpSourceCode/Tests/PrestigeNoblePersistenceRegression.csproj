<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PrestigeNoblePersistenceRegression</AssemblyName>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="netstandard" />
    <Reference Include="TOR_Core">
      <HintPath>$(TORCoreAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(GameBinPath)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Compile Include="PrestigeNoblePersistenceRegression.cs" />
  </ItemGroup>
  <Target Name="CheckRegressionReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TORCoreAssemblyPath)')" Text="Set TORCoreAssemblyPath to the TOR_Core.dll to test." />
    <Error Condition="!Exists('$(GameBinPath)\TaleWorlds.CampaignSystem.dll')" Text="Set GameBinPath to the installed game bin directory." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

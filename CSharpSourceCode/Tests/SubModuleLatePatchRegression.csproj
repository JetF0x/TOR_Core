<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SubModuleLatePatchRegression</AssemblyName>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\</OutputPath>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">$([System.IO.Path]::GetDirectoryName('$(TORCoreAssemblyPath)'))\0Harmony.dll</HarmonyAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="netstandard" />
    <Reference Include="TOR_Core">
      <HintPath>$(TORCoreAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameBinPath)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameBinPath)\TaleWorlds.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Compile Include="SubModuleLatePatchRegression.cs" />
  </ItemGroup>
  <Target Name="CheckRegressionReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TORCoreAssemblyPath)')" Text="Set TORCoreAssemblyPath to the TOR_Core.dll to test." />
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="Set HarmonyAssemblyPath to the bundled 0Harmony.dll." />
    <Error Condition="!Exists('$(GameBinPath)\TaleWorlds.MountAndBlade.dll')" Text="Set GameBinPath to the installed game bin directory." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
